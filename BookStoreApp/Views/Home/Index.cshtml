@model BookStoreApp.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Book Store Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Book Store Management</h2>
    <div>
        <span class="badge bg-primary fs-6 me-2">Total Books: <span id="statBooks">@Model.Books.Count</span></span>
        <span class="badge bg-success fs-6">Total Authors: <span id="statAuthors">@Model.Authors.Count</span></span>
    </div>
</div>

<div class="row">
    <!-- Add Book Form (Uses $.ajax) -->
    <div class="col-md-6">
        <h4>Add New Book ($.ajax)</h4>
        <div class="mb-2">
            <label>Title:</label>
            <input type="text" id="bookTitle" class="form-control" placeholder="Enter book title" />
        </div>
        <div class="mb-2">
            <label>Price:</label>
            <input type="number" step="0.01" id="bookPrice" class="form-control" placeholder="Enter price" />
        </div>
        <div class="mb-3">
            <label>Author:</label>
            <select id="bookAuthorId" class="form-select">
                @foreach (var author in Model.Authors)
                {
                    <option value="@author.Id">@author.Name</option>
                }
            </select>
        </div>
        <button type="button" id="btnAddBook" class="btn btn-primary">Add Book</button>
    </div>

    <!-- Add Author Form (Uses $.post) -->
    <div class="col-md-6">
        <h4>Add New Author ($.post)</h4>
        <div class="mb-2">
            <label>Name:</label>
            <input type="text" id="authorName" class="form-control" placeholder="Enter author name" />
        </div>
        <div class="mb-3">
            <label>Country:</label>
            <input type="text" id="authorCountry" class="form-control" placeholder="Enter country" />
        </div>
        <button type="button" id="btnAddAuthor" class="btn btn-success">Add Author</button>
    </div>
</div>

<hr class="my-4" />

<h3>Books List</h3>
<div class="row" id="booksContainer">
    @foreach (var book in Model.Books)
    {
        <div class="col-md-4 mb-3">
            <div class="card p-3 shadow-sm">
                <h5>@book.Title</h5>
                <p class="mb-1"><strong>Author:</strong> @book.AuthorName</p>
                <p class="mb-2"><strong>Price:</strong> $@book.Price</p>
                <button type="button" class="btn btn-danger btn-sm w-50" onclick="deleteBook(@book.Id)">Remove</button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // 1. $.get -> Refresh stats and books list without reloading page
        function loadDashboardData() {
            $.get('/Home/GetDashboardStats', function (res) {
                $('#statBooks').text(res.totalBooks);
                $('#statAuthors').text(res.totalAuthors);

                let html = '';
                res.books.forEach(b => {
                    html += `
                        <div class="col-md-4 mb-3">
                            <div class="card p-3 shadow-sm">
                                <h5>${b.title}</h5>
                                <p class="mb-1"><strong>Author:</strong> ${b.authorName}</p>
                                <p class="mb-2"><strong>Price:</strong> $${b.price}</p>
                                <button type="button" class="btn btn-danger btn-sm w-50" onclick="deleteBook(${b.id})">Remove</button>
                            </div>
                        </div>`;
                });
                $('#booksContainer').html(html);
            });
        }

        // 2. $.post -> Add Author
        $('#btnAddAuthor').click(function () {
            let name = $('#authorName').val();
            let country = $('#authorCountry').val();
            if (!name) return alert('Author name required');

            $.post('/Home/AddAuthorAjax', { name: name, country: country }, function (res) {
                if (res.success) {
                    $('#authorName').val('');
                    $('#authorCountry').val('');
                    let options = '';
                    res.authors.forEach(a => {
                        options += `<option value="${a.id}">${a.name}</option>`;
                    });
                    $('#bookAuthorId').html(options);
                    loadDashboardData();
                }
            });
        });

        // 3. $.ajax -> Add Book (JSON payload)
        $('#btnAddBook').click(function () {
            let bookData = {
                title: $('#bookTitle').val(),
                price: parseFloat($('#bookPrice').val()) || 0,
                authorId: parseInt($('#bookAuthorId').val())
            };
            if (!bookData.title) return alert('Book title required');

            $.ajax({
                url: '/Home/AddBookAjax',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(bookData),
                success: function (res) {
                    if (res.success) {
                        $('#bookTitle').val('');
                        $('#bookPrice').val('');
                        loadDashboardData();
                    }
                }
            });
        });

        // $.ajax -> Delete Book
        function deleteBook(id) {
            $.ajax({
                url: '/Home/DeleteBookAjax',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        loadDashboardData();
                    }
                }
            });
        }
    </script>
}