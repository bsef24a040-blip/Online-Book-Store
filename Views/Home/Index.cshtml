@model IEnumerable<OnlineBookStore.Models.Book>
@{
    ViewData["Title"] = "Home - Online Book Store";
}

<!-- Hero Banner -->
<div class="bg-primary text-white text-center py-5">
    <div class="container">
        <h1 class="display-4">Welcome to Our Online Book Store</h1>
        <p class="lead">Find your next great read today.</p>
        <a href="#featured" class="btn btn-light btn-lg">Browse Books</a>
    </div>
</div>

<!-- Featured Books (Dynamic from Database) -->
<div class="container my-5" id="featured">
    <h2 class="text-center mb-4">Featured Titles</h2>
    <div class="row g-4">
        @foreach (var book in Model)
        {
            <div class="col-md-3">
                <div class="card h-100 shadow-sm">
                    <img src="@book.ImageUrl" class="card-img-top" alt="@book.Title">
                    <div class="card-body">
                        <h5 class="card-title">@book.Title</h5>
                        <p class="card-text text-muted">@book.Author</p>
                        <h6 class="text-primary">$@book.Price</h6>
                        <a href="#" class="btn btn-sm btn-outline-primary w-100">Add to Cart</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>